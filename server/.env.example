PORT=5000

DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional. Backend image endpoints (generate-image, remove-image-background,
# remove-image-object) exist in aiController.js but have no frontend UI —
# https://clipdrop.co/apis. Leave unset unless you call those routes directly
# or build a UI for them; they 503 gracefully without it.
# CLIPDROP_API_KEY=""

# ── RAG / Knowledge Base ──────────────────────────────────────────────────────

# Qdrant vector database — required for AI Document Chat.
# Use Qdrant Cloud only. Never expose these values to the client.
QDRANT_URL=""
QDRANT_API_KEY=""

# Embeddings route through OpenRouter (OPENROUTER_API_KEY above) using its
# free NVIDIA model by default — no separate OpenAI account/key, no cost.
# Swap EMBEDDING_MODEL="openai/text-embedding-3-small" for higher quality
# (small per-token cost), or set EMBEDDING_PROVIDER=openai + OPENAI_API_KEY
# to call OpenAI directly.
EMBEDDING_PROVIDER="openrouter"
EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b:free"

# ── Optional overrides ────────────────────────────────────────────────────────
# All values below are the built-in defaults. Set them only to change behaviour;
# leaving them out is equivalent to the values shown.

# QDRANT_COLLECTION_NAME="ai_saas_documents"

# Vector size is derived from the model name, so EMBEDDING_VECTOR_SIZE is only
# needed for a model not in the known list:
#   nvidia/nemotron-3-embed-1b:free  → 2048
#   (openai/)text-embedding-3-small  → 1536
#   (openai/)text-embedding-3-large  → 3072
#   (openai/)text-embedding-ada-002  → 1536
# Changing the model changes the vector size — recreate the Qdrant collection.
# EMBEDDING_VECTOR_SIZE="2048"

# Chunking
# RAG_CHUNK_SIZE="1000"
# RAG_CHUNK_OVERLAP="150"

# Retrieval
# RAG_TOP_K="5"
# RAG_SCORE_THRESHOLD="0.0"

# Limits
# MAX_RAG_FILE_SIZE_MB="10"
# MAX_DOCS_PER_USER="50"
